# ---------------------------------------------------------------------------
# CHILL106 / FILE106 frontend configuration
# Copy to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# "devnet" or "mainnet-beta". Defaults to devnet.
VITE_SOLANA_CLUSTER=devnet

# Optional custom RPC. Leave blank to use the public cluster endpoint.
# VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# ---------------------------------------------------------------------------
# Token + Streamflow pool (REQUIRED for the staking console to unlock)
# ---------------------------------------------------------------------------
# SPL mint address of F106/C106. "Later" is NOT a valid address; the UI stays
# in AWAITING POOL CONFIGURATION until this is a real base58 mint.
VITE_TOKEN_MINT=
VITE_TOKEN_SYMBOL=F106
VITE_TOKEN_DECIMALS=8

# Streamflow stake pool PDA (created with the audited STAKE... program).
VITE_STAKE_POOL=

# Streamflow fixed reward pool PDA. Fixed pools are the only reward type the
# installed SDK can create/search reliably.
VITE_REWARD_POOL=
VITE_REWARD_POOL_TYPE=fixed

# ---------------------------------------------------------------------------
# Product parameters (display + pre-flight checks only)
# ---------------------------------------------------------------------------
VITE_STAKE_DURATION_DAYS=182
VITE_TARGET_APY=19
VITE_STAKE_CAP=90
VITE_REWARD_ALLOCATION=10
VITE_PRIORITY_FEE_MICRO_LAMPORTS=20000

# ---------------------------------------------------------------------------
# Safety gate
# ---------------------------------------------------------------------------
# Writes on Mainnet are hard-locked unless this is explicitly "true".
# Keep false until the review in docs/MAINNET_REPORT_TEMPLATE.md is signed off.
VITE_MAINNET_WRITES=false
